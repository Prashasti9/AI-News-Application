# Copy to .env (or set these in your host's dashboard).

# Claude writes the 60-word briefs, "why it matters", key points and the
# background explainer, and scores how important each story is. Without a key
# the app still runs, using extractive summaries and keyword scoring.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium

# Web Push keys. Leave empty to have the server generate a pair on first start
# and save it to data/vapid.json. Set them explicitly in production so they
# survive redeploys (run `npm run vapid` to make a pair).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

PORT=3000
# How often to pull feeds, and how many new stories Claude briefs per run.
REFRESH_MINUTES=30
MAX_SUMMARIES_PER_RUN=15
# Stories Claude rates below this (0-10) are hidden from the feed.
MIN_RELEVANCE=5
# Protects POST /api/refresh. Leave empty to disable the endpoint.
ADMIN_TOKEN=
DATA_DIR=./data
