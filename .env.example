# Copy to .env for local development (or set these in your host's dashboard).
# Everything here is optional; the app runs with no settings at all.

PORT=3000

# Postgres connection string. Leave empty to store data as JSON files in
# DATA_DIR (fine locally). Set it on hosts whose disk is wiped on restart,
# such as Render's free plan. Neon (https://neon.tech) has a free tier.
DATABASE_URL=
DATA_DIR=./data

# Web Push keys. Leave empty to have the server generate a pair on first
# start and save it to storage. Set them explicitly in production
# (run `npm run vapid` to make a pair). If they change, every phone that
# signed up stops receiving notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Daily edition: once a day at EDITION_HOUR (in EDITION_TIMEZONE) the app
# reviews the last day's AI news, publishes the STORIES_PER_DAY most important
# stories and sends one notification listing them.
# Set STORIES_PER_DAY=0 for continuous mode (refresh every REFRESH_MINUTES).
STORIES_PER_DAY=5
EDITION_HOUR=8
# Your timezone, e.g. Asia/Kolkata, Europe/London, America/New_York
EDITION_TIMEZONE=UTC
# How many top candidates are read in full to choose the day's stories.
SHORTLIST_SIZE=15

# Continuous mode only: how often to pull feeds, and how many new stories
# are processed per run.
REFRESH_MINUTES=30
MAX_SUMMARIES_PER_RUN=15

# Stories scoring below this (0-10) are hidden from the feed.
MIN_RELEVANCE=5
# Protects POST /api/refresh. Leave empty to disable the endpoint.
ADMIN_TOKEN=
