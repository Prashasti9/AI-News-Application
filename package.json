{
  "name": "ai-news-shorts",
  "version": "1.0.0",
  "description": "Inshorts-style AI news app with push notifications, curated sources and Claude-written briefs",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "vapid": "node scripts/generate-vapid.js",
    "refresh": "node scripts/refresh-once.js",
    "test": "node --test test/*.test.js"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.2",
    "web-push": "^3.6.7"
  }
}
